# Jung Archive — generation provider configuration
#
# Copy to `.env` and set GENERATION_API_KEY to your NVIDIA NIM key.
# The other variables have safe NVIDIA NIM defaults and may be left as-is.
#
# NEVER commit a real API key.

GENERATION_PROVIDER=openai_compatible
GENERATION_BASE_URL=https://integrate.api.nvidia.com/v1
GENERATION_MODEL=meta/llama-3.2-11b-vision-instruct
GENERATION_API_KEY=
GENERATION_TIMEOUT=60
